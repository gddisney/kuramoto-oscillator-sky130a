# jev_kuramoto -- four corner oscillators, standalone SKY130 signoff for the patent docket.
# Same 25 ns repair as the signed-off blocks.
# Synth r1: 8740 cells, 86608.064 µm². Core 537.28 x 538.56 at 30% (site 0.46 x 2.72).
export DESIGN=jev_kuramoto
export VERILOG_FILES="$DESIGN_DIR/rtl/jev_kuramoto.v"
export CLOCK_PORT=clk CLOCK_PERIOD=25 IO_DELAY_CONSTRAINT=6
export SDC=$FLOW/base.sdc SIGNOFF_SDC=$FLOW/base.sdc
export DIE_AREA="0 0 548.32 560.32"
export PIN_CFG=$DESIGN_DIR/pins.cfg
export PL_TARGET_DENSITY_PCT=30
export DESIGN_REPAIR_MAX_SLEW_PCT=30 DESIGN_REPAIR_MAX_CAP_PCT=25 DESIGN_REPAIR_MAX_WIRE_LENGTH=120
export GRT_DESIGN_REPAIR_MAX_SLEW_PCT=30 GRT_DESIGN_REPAIR_MAX_CAP_PCT=20 GRT_DESIGN_REPAIR_MAX_WIRE_LENGTH=120
export GRT_ADJUSTMENT=0.2
export MAKE_LIB=1
export VDD_NETS=VPWR GND_NETS=VGND
export PDN_MULTILAYER=0 PDN_CORE_RING=0
export PDN_VWIDTH=1.6 PDN_VPITCH=90 PDN_VOFFSET=16.56 PDN_VSPACING=1.7
export PDN_HWIDTH=1.6 PDN_HPITCH=89.76 PDN_HOFFSET=16.32 PDN_HSPACING=1.7
